{
  "compilerOptions": {
    "target": "ES2022",

    "module": "ESNext",
    "moduleResolution": "Node",

    "lib": ["ES2022"],

    "rootDir": ".",
    "outDir": "./dist",

    "strict": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,

    "allowJs": true,

    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },

    "types": ["node"]
  },

  "include": [
    "server.ts",
    "src"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}
